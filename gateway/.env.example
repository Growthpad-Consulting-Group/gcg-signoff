# ─── Gateway listener ───────────────────────────────────────────────────────
GATEWAY_SMTP_HOST=0.0.0.0
GATEWAY_SMTP_PORT=2525
# Comma-separated IP allowlist. Leave empty for local dev; MUST be set to Google's published
# outbound-gateway IP ranges before pointing production Workspace routing here.
GATEWAY_ALLOWED_IPS=
# Set to "true" to log the final message instead of actually relaying it — safe for local testing.
GATEWAY_DRY_RUN=true

# ─── Signoff app (the Next.js app in the repo root) ────────────────────────
RENDER_API_URL=http://localhost:3000/api/render
RENDER_API_SECRET=

# ─── Outbound relay (final delivery hop) ───────────────────────────────────
# Google's SMTP relay service is the default and recommended target — see README.md.
RELAY_SMTP_HOST=smtp-relay.gmail.com
RELAY_SMTP_PORT=587
RELAY_SMTP_USER=
RELAY_SMTP_PASSWORD=
